# Production domain, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Show the phone number on the site (true/false).
NEXT_PUBLIC_SHOW_PHONE=true

# Optional: enables the contact form via Resend (https://resend.com).
# Without these, the form reports it is unavailable and the mailto button keeps working.
RESEND_API_KEY=
CONTACT_TO_EMAIL=pratikshashelke93@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
